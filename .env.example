# Copy to .env. Never commit real keys.
DS_KEY=sk-your-deepseek-key
# Project spelling retained; TYPESAFE_API_KEY is also accepted.
JEV_KET=apikey_your-typesafe-key

# Real backend default: Flash 4.1, explicit thinking=disabled / reasoning_effort=none.
# Not the old deepseek-chat alias or LiteLLM-prefixed model name.
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
JEV_MODEL=jev-1.13.0

# Routing policy, not a calibrated probability of correctness.
# Explicit Jev 'ask' always pauses; near-flat tool preference also pauses.
JEV_CONFIDENCE_FLOOR=0.35

# Skip generation only when the selected tool schema fixes EVERY argument.
# off restores the original path. Neural argument offloading is research-only.
JEV_ARGUMENT_OFFLOAD=deterministic

# Conservative UTF-8 byte budgets INCLUDING reserved prompt/schema overhead.
# These are NOT billed-token counts. Jev's budget must be <=28000.
JEV_CONTEXT_BYTES=24000
DS_CONTEXT_BYTES=96000
