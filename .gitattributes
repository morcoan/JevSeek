* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
.githooks/* text eol=lf
*.ico binary
*.png binary
*.woff binary
*.woff2 binary

# Research protocols/manifests hash exact historical bytes, including some CRLF.
# Do not normalize frozen evidence/source on add or on Windows/Linux checkout.
research/** -text !eol whitespace=trailing-space,space-before-tab,cr-at-eol
